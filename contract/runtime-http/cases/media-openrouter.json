					"action": "generate",
					"prompt": " Rye bread on a bakery counter ",
					"aspect": "16:9",
					"n": 7,
					"provider": "openrouter"
				}
			},
			"upstream": [
				{
					"match": {
						"method": "POST",
						"url": "$OPENROUTER/images",
						"auth": "openrouter",
						"json": {
							"model": "x-ai/grok-imagine-image-2.0",
							"prompt": "Rye bread on a bakery counter",
							"n": 3,
							"aspect_ratio": "16:9",
							"response_format": "b64_json"
						}
					},
					"reply": {
						"status": 200,
						"json": {
							"data": [
								{
									"b64_json": "bm90IGFuIGltYWdl",
									"media_type": "image/png"
								},
								{
									"b64_json": "$B64:small-640x480.jpg"
								}
							],
							"usage": {
								"cost": 0.02
							}
						}
					}
				}
			],
			"expect": {
				"status": 200,
				"json": {
					"ok": true,
					"status": "done",
					"urls": [
						"$FILE:small-640x480.jpg"
					],
					"costUsdTicks": 200000000
				}
			}
		},
