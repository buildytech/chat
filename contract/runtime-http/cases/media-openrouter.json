{
	"$comment": "POST /runtime/v1/media { action: generate } on the desktop signed in with OpenRouter (ADR 0067): one synchronous POST `$OPENROUTER/images` (base64 answers), every picture stored in the local store at once and answered `status: \"done\"` as `/runtime/v1/files/…` addresses with the cost in xAI ticks (OpenRouter reports USD; constants.openrouter.usdTicks). The app reads a done generate without polling. `$B64:<picture>` in a reply is the base64 of a file of pictures/. The xAI deferred flow (media-generate.json) is unchanged. ADR 0068: the request names `provider: \"openrouter\"`, and OpenRouter pictures are switched off by constants (openrouter.mediaEnabled false: 409 provider_role_disabled, cases/media-provider.json); these cases run with `env.openrouterMedia` (the switch on) so the draw stays covered for the day it is turned on.",
	"cases": [
		{
			"name": "openrouter generate draws the candidates at once (base64), stores them and answers them done as local files with the cost",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false,
				"openrouter": true,
				"openrouterMedia": true
			},
			"request": {
				"method": "POST",
				"path": "/runtime/v1/media",
				"json": {
					"action": "generate",
					"prompt": " Rye bread on a bakery counter ",
					"aspect": "16:9",
					"n": 7,
					"provider": "openrouter"
				}
			},
			"upstream": [
				{
					"match": {
						"method": "POST",
						"url": "$OPENROUTER/images",
						"auth": "openrouter",
						"json": {
							"model": "x-ai/grok-imagine-image-2.0",
							"prompt": "Rye bread on a bakery counter",
							"n": 3,
							"aspect_ratio": "16:9",
							"response_format": "b64_json"
						}
					},
					"reply": {
						"status": 200,
						"json": {
							"created": 1,
							"data": [
								{
									"b64_json": "$B64:small-640x480.jpg",
									"media_type": "image/jpeg"
								},
								{
									"b64_json": "$B64:warm-64.png",
									"media_type": "image/png"
								}
							],
							"usage": {
								"cost": 0.04
							}
						}
					}
				}
			],
			"expect": {
				"status": 200,
				"notContains": [
					"$ORKEY"
				],
				"json": {
					"ok": true,
					"status": "done",
					"model": "x-ai/grok-imagine-image-2.0",
					"requestId": "$match:^or-[a-f0-9]{16}$",
					"urls": [
						"$FILE:small-640x480.jpg",
						"$FILE:warm-64.png"
					],
					"costUsdTicks": 400000000
				}
			}
		},
		{
