						"listed": true,
						"chatIds": [],
						"imageIds": [
							"grok-imagine-image-2.0"
						],
						"candidate": null
					}
				}
			}
		},
		{
			"name": "status with a key: the provider is unreachable, not ready",
			"env": {
				"key": true
			},
			"request": {
				"method": "GET",
				"path": "/runtime/v1/status"
			},
			"upstream": [
				{
					"match": {
						"method": "GET",
						"url": "/models"
					},
					"reply": {
						"throw": "network"
					}
				},
				{
					"match": {
						"method": "GET",
						"url": "/language-models"
					},
					"reply": {
						"throw": "network"
					}
				},
				{
					"match": {
						"method": "GET",
						"url": "/image-generation-models"
					},
					"reply": {
						"throw": "network"
					}
				}
			],
			"expect": {
				"status": 200,
				"json": {
					"ready": false,
					"code": "xai_models_list_unavailable",
					"models": {
						"listed": false,
						"candidate": null
					}
				}
			}
		},
		{
			"name": "web hosts never send capabilities (the web app keeps the server loop)",
			"surfaces": [
				"node",
				"vercel"
			],
			"env": {
				"key": false
			},
			"request": {
				"method": "GET",
				"path": "/runtime/v1/status"
			},
			"expect": {
				"status": 503,
				"json": {
					"capabilities": "$absent"
				}
			}
		},
		{
			"name": "desktop sends capabilities: the agent loop runs in the webview",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false
			},
			"request": {
				"method": "GET",
				"path": "/runtime/v1/status"
			},
			"expect": {
				"status": 503,
				"json": {
					"capabilities": {
						"loop": "client",
						"files": "$boolean",
						"saveFile": "$boolean"
					}
				}
			}
		},
		{
			"name": "status names the desktop host: kind, the stamped version (dev without one), os and arch",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false
			},
			"request": {
				"method": "GET",
				"path": "/runtime/v1/status"
			},
			"expect": {
				"status": 503,
				"json": {
					"runtime": "xai-grok",
					"code": "xai_api_key_missing",
					"host": {
						"kind": "desktop",
						"version": "$match:^(?:dev|[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)$",
						"os": "$match:^(darwin|linux|windows)$",
						"arch": "$match:^(amd64|arm64)$"
					}
				}
			}
		},
		{
			"name": "status of a web host sends no host: the app is in a browser",
			"surfaces": [
				"node",
				"vercel"
			],
			"env": {
				"key": false
			},
			"request": {
				"method": "GET",
				"path": "/runtime/v1/status"
			},
			"expect": {
				"status": 503,
				"json": {
					"runtime": "xai-grok",
					"code": "xai_api_key_missing",
					"host": "$absent"
				}
			}
		},
		{
			"name": "desktop offers the OpenRouter sign-in: capabilities.signIn, provider xai while signed out",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false
			},
			"request": {
				"method": "GET",
				"path": "/runtime/v1/status"
			},
			"expect": {
				"status": 503,
				"json": {
					"code": "xai_api_key_missing",
					"capabilities": {
						"signIn": [
							"openrouter"
						]
					},
					"provider": {
						"id": "xai",
						"signedIn": false,
						"pending": false
					}
				}
			}
		},
		{
			"name": "desktop signed in with OpenRouter: provider openrouter, the allowed x-ai chat and image models it lists, x-ai/grok-4.20 the candidate",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false,
				"openrouter": true
			},
			"request": {
				"method": "GET",
				"path": "/runtime/v1/status"
			},
			"upstream": [
				{
					"match": {
						"method": "GET",
						"url": "$OPENROUTER/models",
						"auth": "openrouter"
					},
					"reply": {
						"status": 200,
						"json": {
							"data": [
								{
									"id": "openai/gpt-5"
								},
								{
									"id": "x-ai/grok-4.7"
								},
								{
									"id": "x-ai/grok-4.20"
								},
								{
									"id": "x-ai/grok-3-mini"
								}
							]
						}
					}
				},
				{
					"match": {
						"method": "GET",
						"url": "$OPENROUTER/images/models",
						"auth": "openrouter"
					},
					"reply": {
						"status": 200,
						"json": {
							"data": [
								{
									"id": "google/gemini-3-pro-image"
								},
								{
									"id": "x-ai/grok-imagine-image-2.0"
								}
							]
						}
					}
				}
			],
			"expect": {
				"status": 200,
				"notContains": [
					"$ORKEY"
				],
				"json": {
					"runtime": "xai-grok",
					"ready": true,
					"liveModel": true,
					"code": "xai_runtime_ready",
					"key": {
						"present": true,
						"source": "keychain"
					},
					"provider": {
						"id": "openrouter",
						"signedIn": true,
						"pending": false
					},
					"models": {
						"listed": true,
						"chatIds": [
							"x-ai/grok-4.20",
							"x-ai/grok-4.7"
						],
						"imageIds": [
							"x-ai/grok-imagine-image-2.0"
						],
						"candidate": "x-ai/grok-4.20",
						"toolCallingProven": false
					},
					"contract": "$CONTRACT"
				}
			}
		},
