				},
				"signedIn": false
			}
		},
		{
			"name": "auth callback: the state is used once, a refused code does not leave the sign-in open",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false,
				"pendingSignIn": {
					"state": "st-contract-0000000000000000000000000000000",
