			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false,
				"pendingSignIn": {
					"state": "st-contract-0000000000000000000000000000000",
					"verifier": "$VERIFIER"
				}
			},
			"request": {
				"listener": "callback",
