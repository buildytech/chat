				"path": "/cb/st-contract-0000000000000000000000000000000",
				"query": "code=c-contract-1"
			},
			"upstream": [
				{
					"match": {
						"method": "POST",
						"url": "$OPENROUTER/auth/keys",
						"auth": "none",
						"json": {
							"code": "c-contract-1",
							"code_verifier": "$VERIFIER",
							"code_challenge_method": "S256"
