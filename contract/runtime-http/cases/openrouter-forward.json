{
	"$comment": "POST /runtime/v1/openrouter/chat/completions: the desktop host's forward of one OpenRouter Chat Completions request for the webview's agent loop, when the user signed in with OpenRouter (ADR 0067). Same rules as the xAI forward (placeholder key `host-held` replaced by the user's key, one path and method, 256000 bytes, no redirect, the key redacted), plus: only constants.openrouter.chatModels that OpenRouter lists (never the image model), and the webview's `x-grok-conv-id` goes out as OpenRouter's `x-session-id` (sticky routing for the prompt cache). `match.headers` checks request headers (`$absent`: not sent); `$OPENROUTER/` URLs are relative to the OpenRouter base; `auth: \"openrouter\"` is the user's key (`$ORKEY`).",
	"cases": [
		{
			"name": "openrouter forward without a sign-in is 503 openrouter_key_missing, no provider call",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": true
			},
			"request": {
				"method": "POST",
				"path": "/runtime/v1/openrouter/chat/completions",
				"headers": {
					"authorization": "Bearer host-held",
					"x-grok-conv-id": "chat-k"
				},
				"json": {
					"model": "x-ai/grok-4.20",
					"messages": [
						{
							"role": "system",
							"content": "BuildY page agent"
						},
						{
							"role": "user",
							"content": "Hi"
						}
					],
					"tools": [],
					"tool_choice": "auto",
					"stream": false,
					"reasoning": {
						"enabled": false
					}
				}
			},
			"expect": {
				"status": 503,
				"json": {
					"error": {
						"code": "openrouter_key_missing"
					}
				}
			}
		},
