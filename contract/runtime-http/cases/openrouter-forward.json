						}
					},
					"reply": {
						"status": 200,
						"json": {
							"id": "gen-1",
							"model": "x-ai/grok-4.20",
							"provider": "xAI",
							"choices": [
								{
									"index": 0,
									"message": {
										"role": "assistant",
										"content": "Hello."
									},
									"finish_reason": "stop"
								}
							],
							"usage": {
								"prompt_tokens": 12,
								"completion_tokens": 3,
								"total_tokens": 15,
								"cost": 2.25e-05
							}
						}
					}
				}
			],
			"expect": {
				"status": 200,
				"notContains": [
					"$ORKEY"
				],
				"headers": {
					"content-type": "application/json",
					"cache-control": "no-store"
				},
				"json": {
					"id": "gen-1",
					"model": "x-ai/grok-4.20",
					"provider": "xAI",
					"choices": [
						{
							"index": 0,
							"message": {
								"role": "assistant",
								"content": "Hello."
							},
							"finish_reason": "stop"
						}
					],
					"usage": {
						"prompt_tokens": 12,
						"completion_tokens": 3,
						"total_tokens": 15,
						"cost": 2.25e-05
					}
				}
			}
		},
