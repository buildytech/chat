{
	"$comment": "POST /runtime/v1/xai/chat/completions: the desktop host's forward of one xAI Chat Completions request for the agent loop that runs in its webview (capabilities.loop \"client\", ADR 0065). The webview sends the placeholder key `host-held`; the host puts its own key on the request, accepts only a model its key lists, caps the body at 256000 bytes, follows no redirect and never answers with the key. The web runtimes run the loop themselves and have no forward.",
	"cases": [
		{
			"name": "forward without a key is 503 xai_api_key_missing, no provider call",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false
			},
			"request": {
				"method": "POST",
				"path": "/runtime/v1/xai/chat/completions",
				"headers": {
					"authorization": "Bearer host-held",
					"x-grok-conv-id": "chat-k"
				},
				"json": {
					"model": "$CANDIDATE",
					"messages": [
						{
							"role": "system",
							"content": "BuildY page agent"
						},
						{
							"role": "user",
							"content": "Hi"
						}
					],
					"tools": [],
					"tool_choice": "auto",
					"stream": false
				}
			},
			"expect": {
				"status": 503,
				"json": {
					"error": {
						"code": "xai_api_key_missing"
					}
				}
			}
		},
