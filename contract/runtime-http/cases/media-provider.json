{
	"$comment": "POST /runtime/v1/media { action: generate, provider?, model? } with a provider per role (ADR 0068). `provider` absent or \"xai\" draws with xAI (on the desktop too, whatever other key it holds: no default to OpenRouter, no fallback); \"openrouter\" is refused with 409 provider_role_disabled while OpenRouter pictures are off (constants.openrouter.mediaEnabled); `model`, when sent, must be that provider's image model (a chat model never draws). Desktop only: the owner's approved image list (GET/PUT /runtime/v1/settings/providers, `env.approved`) narrows it (403 model_not_approved, never widens). A 402, or a 403 naming a key or credit limit, is 502 provider_limit and the host reports that provider `state: \"limit\"` (`expect.limitedAfter`).",
	"cases": [
		{
			"name": "generate names provider xai: xAI draws as before (202, request id)",
			"env": {
				"key": true
			},
			"request": {
				"method": "POST",
				"path": "/runtime/v1/media",
				"json": {
					"action": "generate",
					"prompt": " Rye bread on a bakery counter ",
					"aspect": "4:3",
					"n": 3,
					"provider": "xai"
				}
			},
			"upstream": [
				{
					"match": {
						"method": "POST",
						"url": "/images/generations",
						"auth": "bearer",
						"json": {
							"model": "$IMAGE_MODEL",
							"prompt": "Rye bread on a bakery counter",
							"n": 3,
							"aspect_ratio": "4:3",
							"response_format": "url",
							"deferred": true
						}
					},
					"reply": {
						"status": 200,
						"json": {
							"request_id": "rq-roles-1"
						}
					}
				}
			],
			"expect": {
				"status": 202,
				"notContains": [
					"$KEY"
				],
				"json": {
					"ok": true,
					"requestId": "rq-roles-1",
					"model": "$IMAGE_MODEL"
				}
			}
		},
		{
			"name": "generate names provider openrouter while OpenRouter pictures are off: 409 provider_role_disabled, no provider call",
			"env": {
				"key": true
			},
			"request": {
				"method": "POST",
				"path": "/runtime/v1/media",
				"json": {
					"action": "generate",
					"prompt": " Rye bread on a bakery counter ",
					"aspect": "4:3",
					"n": 3,
					"provider": "openrouter"
				}
			},
			"expect": {
				"status": 409,
				"json": {
					"ok": false,
					"code": "provider_role_disabled"
				}
			}
		},
		{
			"name": "generate names an unknown provider: 422 invalid_request, no provider call",
			"env": {
				"key": true
			},
			"request": {
				"method": "POST",
				"path": "/runtime/v1/media",
				"json": {
					"action": "generate",
					"prompt": " Rye bread on a bakery counter ",
					"aspect": "4:3",
					"n": 3,
					"provider": "openai"
				}
			},
			"expect": {
				"status": 422,
				"json": {
					"ok": false,
					"code": "invalid_request"
				}
			}
		},
