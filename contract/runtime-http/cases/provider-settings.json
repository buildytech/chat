		{
			"name": "settings: a body that is not JSON is 400 invalid_json",
			"surfaces": [
				"desktop"
			],
			"env": {
				"key": false
			},
			"request": {
				"method": "PUT",
				"path": "/runtime/v1/settings/providers",
				"text": "{not json"
			},
			"expect": {
				"status": 400,
				"json": {
					"ok": false,
					"code": "invalid_json"
