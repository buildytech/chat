{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "npm ci",
	"buildCommand": "node scripts/bundle-vercel-runtime.mjs && node scripts/build-render-bundle.mjs && npm run build --workspace=@buildytech/chat-web",
	"outputDirectory": "apps/chat-web/build",
	"functions": {
		"api/runtime/v1/status.ts": {
			"maxDuration": 60
		},
		"api/runtime/v1/run.ts": {
			"maxDuration": 300
		}
	},
	"rewrites": [
		{
			"source": "/runtime",
			"destination": "/api/runtime/v1/status"
		},
		{
			"source": "/runtime/v1/status",
			"destination": "/api/runtime/v1/status"
		},
		{
			"source": "/runtime/v1/run",
			"destination": "/api/runtime/v1/run"
		},
		{
			"source": "/((?!api(?:/|$)|runtime(?:/|$)|_app(?:/|$)).*)",
			"destination": "/200.html"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=63072000; includeSubDomains; preload"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), interest-cohort=()"
				},
				{
					"key": "Content-Security-Policy",
					"value": "frame-ancestors 'self'"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				}
			]
		}
	]
}
