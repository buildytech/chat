{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "npm ci",
	"buildCommand": "npm run build --workspace=@buildytech/chat-web",
	"outputDirectory": "apps/chat-web/build",
	"functions": {
		"api/runtime/[...path].ts": {
			"maxDuration": 60,
			"includeFiles": "packages/builder-core/src/catalog/**"
		}
	},
	"rewrites": [
		{ "source": "/runtime", "destination": "/api/runtime/v1/status" },
		{ "source": "/runtime/:path*", "destination": "/api/runtime/:path*" },
		{ "source": "/((?!api(?:/|$)|runtime(?:/|$)|_app(?:/|$)).*)", "destination": "/200.html" }
	]
}
