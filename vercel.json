{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "npm ci",
	"buildCommand": "node scripts/bundle-vercel-runtime.mjs && npm run build --workspace=@buildytech/chat-web",
	"outputDirectory": "apps/chat-web/build",
	"functions": {
		"api/runtime/v1/status.ts": {
			"runtime": "nodejs22.x",
			"maxDuration": 60
		},
		"api/runtime/v1/run.ts": {
			"runtime": "nodejs22.x",
			"maxDuration": 60
		}
	},
	"rewrites": [
		{ "source": "/runtime", "destination": "/api/runtime/v1/status" },
		{ "source": "/runtime/v1/status", "destination": "/api/runtime/v1/status" },
		{ "source": "/runtime/v1/run", "destination": "/api/runtime/v1/run" },
		{ "source": "/((?!api(?:/|$)|runtime(?:/|$)|_app(?:/|$)).*)", "destination": "/200.html" }
	]
}
