# /etc/site/site.env (root:site, mode 0640). Copy, edit, never commit the real file.
SITE_ENV=production
# public https address, no trailing slash
SITE_BASE_URL=https://example.com
SITE_DATA_DIR=/var/lib/site/pb_data
# who may open /_/ and /api/* (except /api/health): peers without forwarding
# headers from these networks. Default: loopback only (use the SSH tunnel).
SITE_ADMIN_ALLOW=127.0.0.1/32,::1/128
# Caddy's address as seen by the site: X-Forwarded-For is trusted only from here.
# Same host: 127.0.0.1/32. Caddy on the incus host: the bridge gateway, e.g. 10.10.10.1/32.
SITE_TRUSTED_PROXIES=127.0.0.1/32
# Request logs written by the app (PocketBase _logs): off | anon | full.
# off = nothing is written (default). Enabling anon/full requires updating
# the privacy policy and agreements first (PRIVACY.md).
SITE_ACCESS_LOG=off
# SITE_PRESET is stored in the database by `site init`; leave it unset here.
# Never set SITE_DEMO_PASSWORD in production (the site refuses to start).
