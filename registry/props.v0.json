			"schema": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"title": "HeroSimpleProps",
				"description": "The simple hero (model hero@1): an optional badge, the heading, a description, up to two links as the actions (links styled as buttons, the first primary, the second secondary: each drawn only when its label and its address are both set) and one picture. Axes: media (end: the picture after the copy, start: before it, top: above it, wide), frame (box: inside the container; split: two halves, the picture to the edge of the screen).",
				"type": "object",
				"properties": {
					"id": {
						"$ref": "#/$defs/text"
					},
					"badge": {
						"description": "a short pill above the heading; empty: no badge",
						"$ref": "#/$defs/text",
						"default": ""
					},
					"title": {
						"$ref": "#/$defs/text"
					},
					"description": {
						"description": "one paragraph under the heading; empty: none",
						"$ref": "#/$defs/text",
						"default": ""
					},
					"image": {
						"description": "address of the picture (an https URL or a path); none: the placeholder",
						"$ref": "#/$defs/text"
					},
					"imageAlt": {
						"description": "alt text of the picture; none: the title",
						"$ref": "#/$defs/text"
					},
					"imageDark": {
						"description": "address of the picture in the dark theme; none: image",
						"$ref": "#/$defs/text"
					},
					"actionLabel": {
						"description": "the label of the action; the link is drawn when the label and the address are both set",
						"$ref": "#/$defs/text",
						"default": ""
					},
					"actionHref": {
						"description": "the address of the action",
						"$ref": "#/$defs/text",
						"default": ""
					},
					"secondaryActionLabel": {
						"description": "the label of the second action (the secondary button after the first); drawn when the label and the address are both set",
						"$ref": "#/$defs/text",
						"default": ""
					},
					"secondaryActionHref": {
						"description": "the address of the second action",
						"$ref": "#/$defs/text",
						"default": ""
					},
					"level": {
						"description": "the level of the heading (1 on the first section of a page)",
						"enum": [
							1,
							2,
							3
						],
						"default": 2
					},
					"padding": {
						"description": "the vertical padding of the section: compact (py-8 lg:py-16), standard (py-16 lg:py-32), spacious (py-24 lg:py-40)",
