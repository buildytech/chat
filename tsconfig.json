{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"allowImportingTsExtensions": true
	},
	"include": [
		"api/**/*.ts",
		"middleware.ts",
		"packages/builder-core/src/**/*.ts",
		"apps/xai-runtime/src/**/*.ts"
	]
}
