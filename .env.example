# Environment of BuildY chat-web (12-factor). Copy to `.env` for local runs; never commit real values.
# Only the names are documented here. Secrets (XAI_API_KEY, Basic Auth) are never VITE_* / PUBLIC_*.

# --- Optional builder modules (build time; docs/adr 0041) --------------------------------------------------
# VITE_MODULE_CHAT: the chat module (Ask / Build conversation, proposals, live model client).
#   on unless set to 0, false, off or no (any case). Default: on.
#   off: the page builder (Blocks feed, Sections, Inspector, Preview, Code, export) builds and runs without a
#   trace of the chat: no chat code, texts, routes, API calls or project keys in the bundle (npm run modules:check).
#   It is read when the app is built or the dev server starts: change it, then rebuild or restart.
VITE_MODULE_CHAT=1

# --- Live model runtime (only used with the chat module on) -------------------------------------------------
# Where the dev / preview server proxies /runtime (default http://127.0.0.1:18100).
# XAI_RUNTIME_PROXY_TARGET=http://127.0.0.1:18100
# Local runtime process (apps/xai-runtime):
# BUILDY_RUNTIME_PORT=18100
# BUILDY_RUNTIME_BIND=127.0.0.1
# XAI_API_KEY=
# Basic Auth for a non-loopback bind and for Vercel (fail closed when missing):
# BUILDY_RUNTIME_BASIC_AUTH_USER=
# BUILDY_RUNTIME_BASIC_AUTH_PASSWORD=

# --- Build and platform (read by apps/chat-web/config.js and the runtime; set by the platform, not by hand) ---
# BUILDY_BUILD_DIR=build            Output directory of the static build (the chat-off no-trace check builds into build-nochat).
# VERCEL_GIT_COMMIT_SHA=            Set by Vercel at build time; named in exported session files.
# VERCEL=1, VERCEL_ENV=preview      Set by Vercel; the runtime treats a Vercel surface as shared and public (Basic Auth required).
