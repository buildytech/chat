{
  "name": "@buildytech/chat",
  "private": true,
  "version": "0.0.0",
  "description": "BuildY Chat: browser-first creator of websites from UI8Kit registry blocks (Svelte 5 SPA, optional protected xAI runtime)",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/chat-web",
    "apps/xai-runtime",
    "packages/page-contract",
    "packages/ports",
    "packages/builder-core",
    "packages/chat-agent"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@buildytech/chat-web",
    "build": "npm run build --workspace=@buildytech/chat-web",
    "bundle:runtime": "node scripts/bundle-vercel-runtime.mjs && node scripts/build-render-bundle.mjs",
    "test": "npm run test:unit",
    "check": "npm run typecheck && npm run lint && npm run lint:ratchet && npm run lint:dead && npm run lint:ui8px && npm run check --workspace=@buildytech/chat-web",
    "verify": "npm test && npm run inspector:coverage:check && npm run secrets:check && npm run audit:prod && npm run check && npm run build && npm run modules:check:trace",
    "modules:check": "node scripts/check-modules.mjs",
    "modules:check:trace": "node scripts/check-modules.mjs --no-trace",
    "snapshot": "node scripts/snapshot.mjs",
    "snapshot:check": "node scripts/snapshot.mjs --check",
    "snapshot:derive": "node scripts/snapshot.mjs --derive",
    "schema:check": "node scripts/check-page-spec-schema.mjs",
    "theme:neutrals": "node scripts/skin-neutrals.mjs",
    "theme:neutrals:check": "node scripts/skin-neutrals.mjs --check",
    "inspector:coverage": "node --experimental-strip-types --import ./packages/builder-core/src/catalog/props-gate.ts scripts/inspector-coverage.mjs",
    "inspector:coverage:check": "node --experimental-strip-types --import ./packages/builder-core/src/catalog/props-gate.ts scripts/inspector-coverage.mjs --check",
    "registry:snapshot": "node scripts/registry-snapshot.mjs",
    "registry:check": "node scripts/registry-snapshot.mjs --check",
    "test:unit": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint packages apps",
    "lint:ratchet": "node scripts/check-ratchet.mjs",
    "lint:ui8px": "node scripts/ui8px-extract.mjs",
    "test:live": "node scripts/run-tests.mjs live",
    "lint:dead": "node scripts/check-dead.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-svelte": "^3.24.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "typescript-eslint": "^8.72.2",
    "ui8px": "^0.2.5"
  }
}
