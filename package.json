{
  "name": "@buildytech/chat",
  "private": true,
  "version": "0.0.0",
  "description": "CMS-agnostic SI Chat Website Builder monorepo",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/chat-web",
    "packages/page-contract",
    "packages/ports",
    "adapters/wordpress"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@buildytech/chat-web",
    "build": "npm run build --workspace=@buildytech/chat-web",
    "test": "npm run test --workspace=@buildytech/page-contract && npm run test:unit",
    "check": "npm run check --workspace=@buildytech/chat-web",
    "verify": "npm test && npm run check && npm run build",
    "test:api": "node --experimental-strip-types --test scripts/m4-api-tests/*.test.ts scripts/m4-api-tests/*.integration.test.ts",
    "test:unit": "node --experimental-strip-types --test scripts/m4-api-tests/map.test.ts scripts/m4-api-tests/gateway.retry.test.ts scripts/m4-api-tests/session-url.test.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
